# ============================================================
# ALPACA CREDENTIALS
# Get these from: https://alpaca.markets → API Keys
# ============================================================
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# Use "paper" for paper trading (safe, no real money)
# Use "live" only when you're ready for real money
ALPACA_MODE=paper

# ============================================================
# APP SETTINGS
# ============================================================
APP_SECRET_KEY=change_this_to_a_random_string_123
DASHBOARD_PASSWORD=admin123

# ============================================================
# RISK SETTINGS (safe defaults for beginners)
# ============================================================
MAX_PORTFOLIO_RISK_PCT=0.02      # Max 2% of portfolio per trade
MAX_DAILY_LOSS_PCT=0.05          # Auto-stop if down 5% in a day
MAX_OPEN_POSITIONS=5             # Never hold more than 5 stocks
